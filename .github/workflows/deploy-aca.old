name: Deploy to Azure Container Apps

on:
  workflow_run:
    workflows:
      - Build and Publish Docker Image
    types:
      - completed
  workflow_dispatch:
    inputs:
      target:
        description: Environnement cible
        required: true
        type: choice
        options:
          - recette
          - production
        default: recette
      image_tag:
        description: Tag Docker a deployer
        required: true
        default: latest
        type: string

permissions:
  contents: read

jobs:
  deploy:
    if: >-
      ${
        {
          github.event_name == 'workflow_dispatch' ||
          (
            github.event_name == 'workflow_run' &&
            github.event.workflow_run.conclusion == 'success' &&
            github.event.workflow_run.head_branch == 'main'
          )
        }
      }
    runs-on: ubuntu-latest
    environment: ${{ github.event_name == 'workflow_dispatch' && inputs.target || 'recette' }}
    env:
      REGISTRY: ghcr.io
      IMAGE_NAME: ${{ github.repository }}
      ACA_APP_NAME_RE7: ${{ vars.ACA_APP_NAME_RE7 }}
      ACA_APP_NAME_PROD: ${{ vars.ACA_APP_NAME_PROD }}
      AZURE_RESOURCE_GROUP_RE7: ${{ vars.AZURE_RESOURCE_GROUP_RE7 }}
      AZURE_RESOURCE_GROUP_PROD: ${{ vars.AZURE_RESOURCE_GROUP_PROD }}
      AZURE_CONTAINERAPPS_ENV_RE7: ${{ vars.AZURE_CONTAINERAPPS_ENV_RE7 }}
      AZURE_CONTAINERAPPS_ENV_PROD: ${{ vars.AZURE_CONTAINERAPPS_ENV_PROD }}

    steps:
      - name: Resolve deployment target
        id: target
        shell: bash
        run: |
          set -euo pipefail

          if [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            target="${{ inputs.target }}"
            image_tag="${{ inputs.image_tag }}"
          else
            target="recette"
            image_tag="latest"
          fi

          case "$target" in
            recette)
              app_name="${ACA_APP_NAME_RE7}"
              resource_group="${AZURE_RESOURCE_GROUP_RE7}"
              aca_env="${AZURE_CONTAINERAPPS_ENV_RE7}"
              max_replicas="2"
              ;;
            production)
              app_name="${ACA_APP_NAME_PROD}"
              resource_group="${AZURE_RESOURCE_GROUP_PROD}"
              aca_env="${AZURE_CONTAINERAPPS_ENV_PROD}"
              max_replicas="3"
              ;;
            *)
              echo "Cible inconnue: $target" >&2
              exit 1
              ;;
          esac

          for value in "$app_name" "$resource_group" "$aca_env"; do
            if [[ -z "$value" ]]; then
              echo "Variables GitHub manquantes pour la cible $target" >&2
              exit 1
            fi
          done

          echo "target=$target" >> "$GITHUB_OUTPUT"
          echo "image_tag=$image_tag" >> "$GITHUB_OUTPUT"
          echo "app_name=$app_name" >> "$GITHUB_OUTPUT"
          echo "resource_group=$resource_group" >> "$GITHUB_OUTPUT"
          echo "aca_env=$aca_env" >> "$GITHUB_OUTPUT"
          echo "max_replicas=$max_replicas" >> "$GITHUB_OUTPUT"

      - name: Azure login
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Create or update Azure Container App
        uses: azure/cli@v2
        env:
          APP_NAME: ${{ steps.target.outputs.app_name }}
          RESOURCE_GROUP: ${{ steps.target.outputs.resource_group }}
          ACA_ENV: ${{ steps.target.outputs.aca_env }}
          IMAGE: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ steps.target.outputs.image_tag }}
          MAX_REPLICAS: ${{ steps.target.outputs.max_replicas }}
          GHCR_USERNAME: ${{ secrets.GHCR_USERNAME }}
          GHCR_TOKEN: ${{ secrets.GHCR_TOKEN }}
        with:
          inlineScript: |
            set -euo pipefail

            az extension add --name containerapp --upgrade

            if az containerapp show --name "$APP_NAME" --resource-group "$RESOURCE_GROUP" >/dev/null 2>&1; then
              az containerapp registry set \
                --name "$APP_NAME" \
                --resource-group "$RESOURCE_GROUP" \
                --server ghcr.io \
                --username "$GHCR_USERNAME" \
                --password "$GHCR_TOKEN"

              az containerapp update \
                --name "$APP_NAME" \
                --resource-group "$RESOURCE_GROUP" \
                --image "$IMAGE" \
                --set-env-vars NODE_ENV=production HOST=0.0.0.0 PORT=3000 \
                --min-replicas 1 \
                --max-replicas "$MAX_REPLICAS"
            else
              az containerapp create \
                --name "$APP_NAME" \
                --resource-group "$RESOURCE_GROUP" \
                --environment "$ACA_ENV" \
                --image "$IMAGE" \
                --ingress external \
                --target-port 3000 \
                --registry-server ghcr.io \
                --registry-username "$GHCR_USERNAME" \
                --registry-password "$GHCR_TOKEN" \
                --env-vars NODE_ENV=production HOST=0.0.0.0 PORT=3000 \
                --cpu 0.5 \
                --memory 1Gi \
                --min-replicas 1 \
                --max-replicas "$MAX_REPLICAS"
            fi
